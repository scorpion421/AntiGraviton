# Local episodic project memory (isolated per workstation)
.agents/memory.db*

# OS and IDE configuration
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local credentials and secret stores
credentials/
*.credential.xml

# Test scratch folders
tests/scratch*/
