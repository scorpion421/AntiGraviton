# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary and backup files
*.bak*
database/*.bak*
*.tmp
*.log

# SQLite temporary journal and lock files
*.db-wal
*.db-shm
