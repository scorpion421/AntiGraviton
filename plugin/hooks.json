{
  "skillsdb-autonomous-memory": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python \"%USERPROFILE%/.gemini/database/db_manager.py\" mem-pre-invocation-hook",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python \"%USERPROFILE%/.gemini/database/db_manager.py\" guardrail-pre-tool-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
